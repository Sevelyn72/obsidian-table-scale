{
	"name": "obsidian-table-scale",
	"version": "1.2.0",
	"description": "Adjust Markdown table width or scale tables and formulas by dragging their outer edges.",
	"author": "Sevelyn",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"version": "node version-bump.mjs",
		"lint": "eslint src --max-warnings 0",
		"test": "node scripts/test.mjs",
		"check": "npm run lint && npm test && npm run build && npm run validate",
		"validate": "node scripts/validate-release.mjs",
		"package": "npm run check && node scripts/package-release.mjs"
	},
	"keywords": [
		"obsidian",
		"markdown",
		"table",
		"scale"
	],
	"license": "0BSD",
	"private": true,
	"engines": {
		"node": ">=22.13.0"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.12.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
